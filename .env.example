# ─── Anthropic (cerveau du coach) ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CAIRN_MODEL=claude-opus-5
CAIRN_MODEL_FAST=claude-sonnet-5

# ─── Strava ──────────────────────────────────────────────────────────────────
# https://www.strava.com/settings/api  →  créer une application
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:4000/auth/strava/callback
# Jeton arbitraire que tu choisis : Strava le renvoie lors du handshake webhook
STRAVA_WEBHOOK_VERIFY_TOKEN=cairn-verify-me
# URL publique atteignable par Strava (ex. ngrok) pour les webhooks
PUBLIC_BASE_URL=http://localhost:4000
# Cadence de la relève des nouvelles activités, en minutes (0 = désactivée).
# 15 min : au pire 4 requêtes par fenêtre de quota, une centaine par jour.
CAIRN_POLL_INTERVAL_MIN=15

# ─── Base de données ─────────────────────────────────────────────────────────
DATABASE_URL=file:./data/cairn.sqlite

# ─── Serveur ─────────────────────────────────────────────────────────────────
API_PORT=4000
# Le navigateur n'appelle qu'une origine : celle qui lui a servi la page. Next
# relaie /api, /health et /auth vers l'API, si bien qu'aucune adresse d'API n'est
# à publier au client : le téléphone n'a qu'une adresse à connaître, celle que
# Tailscale Serve donne au site (npm run service -- status). WEB_ORIGIN ne sert
# plus qu'aux clients qui appellent l'API directement (curl, MCP) ; il n'y a plus
# d'appel inter-origine depuis le site.
WEB_ORIGIN=http://localhost:3000
